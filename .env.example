# ============================================================
# CÁCH 1 (khuyến nghị) — Apps Script gắn trong Google Sheet
# Không cần Google Cloud, không cần service account.
# Xem hướng dẫn ở đầu file apps-script/Code.gs
# ============================================================
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# ============================================================
# CÁCH 2 — Service account + Google Sheets API
# Chỉ dùng khi bỏ trống 2 dòng trên.
# ============================================================
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Tên 2 tab trong sheet (chỉ dùng cho Cách 2)
SHEET_TAB_RESULTS=KetQua
SHEET_TAB_LEVELS=BacNangLuc

# Thoi gian cache (giay). Cung la do tre toi da tu luc sua sheet den luc web cap nhat.
CACHE_TTL_SECONDS=300

# Cache cua dev server (giay). Dat 0 de luon doc moi khi dang phat trien.
DEV_CACHE_TTL_SECONDS=30
