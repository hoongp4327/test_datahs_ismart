# ============================================================
# Sao chép file này thành .env rồi điền giá trị.
# KHÔNG điền giá trị thật vào file này — nó nằm trên GitHub công khai.
# ============================================================

# --- Nguồn dữ liệu (chọn một) --------------------------------

# Cách A — Apps Script gắn trong Google Sheet (xem apps-script/Code.gs)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Cách B — Service account + Google Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ID của Google Sheet (lấy từ URL .../spreadsheets/d/<ID>/edit).
# Cần cho cách B. Với cách A, nếu điền thì website đọc thẳng sheet công khai
# khi Apps Script lỗi — chỉ chạy được khi sheet mở "Bất kỳ ai có đường liên kết".
GOOGLE_SHEET_ID=

# --- Trang quản trị /quan-tri ----------------------------
# Khoá bí mật, tối thiểu 16 ký tự. Link quản trị = https://<site>/quan-tri#<ADMIN_KEY>
# Đổi khoá = mọi link cũ hết hiệu lực. Để trống = tắt trang quản trị.
ADMIN_KEY=

# --- Tên 3 tab trong sheet (để trống = dùng mặc định) ---------
SHEET_TAB_KET_QUA=KetQua
SHEET_TAB_MO_TA=MoTaKyNang
SHEET_TAB_THANG_LEVEL=ThangLevel

# --- Cache (giây) -------------------------------------------
CACHE_TTL_SECONDS=60
DEV_CACHE_TTL_SECONDS=60

# --- Chạy bằng dữ liệu mẫu, bỏ qua Google (để xem giao diện) ---
# NGUON_DU_LIEU=mau
